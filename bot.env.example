# Скопируйте этот файл в bot.env и впишите свои значения.
# bot.env в GitHub НЕ попадёт (он в .gitignore).

BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER
# Кому шлём заказы. Несколько получателей — через запятую,
# например: 8879836353,123456789. Свой ID узнать у @userinfobot.
ADMIN_ID=8879836353
CONSULTANT_USERNAME=Zufarovsstore
MINI_APP_URL=https://farruxz15.github.io/zufarovs-store/

# Для оплаты картой (необязательно):
CARD_NUMBER=
CARD_HOLDER=Zufarova Sarvinoz
CARD_BANK=Uzcard

# Закупочные цены — чтобы бот считал прибыль в уведомлении о заказе.
# Значение получить командой: python3 export_costs.py
# Локально можно не заполнять: подхватится costs.json (он в .gitignore).
# В GitHub эти цены попадать НЕ должны — репозиторий публичный.
PRODUCT_COSTS=

# Для расчёта себестоимости веса. Держать одинаковыми с reprice.py.
KG_FEE_USD=10
USD_RATE=12350
